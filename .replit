entrypoint = "scripts/replit.py"
modules = ["python-3.12", "nodejs-22"]
run = ["python3", "scripts/replit.py", "run"]

[deployment]
deploymentTarget = "vm"
build = ["python3", "scripts/replit.py", "build"]
run = ["python3", "scripts/replit.py", "start"]

[env]
PORT = "5000"
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = "1"
PUPPETEER_SKIP_DOWNLOAD = "true"

[[ports]]
localPort = 5000
externalPort = 80

[packager.features]
guessImports = false
enabledForHosting = false
