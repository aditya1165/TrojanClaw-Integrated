# Application
APP_NAME=TrojanClaw API
APP_VERSION=0.2.0
APP_ENV=development
APP_DEBUG=false
SINGLE_USER_ID=00000000-0000-0000-0000-000000000001
SINGLE_USER_NAME=TrojanClaw User

# Supabase HTTP API (never use the PostgreSQL DSN for SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-server-side-supabase-key

# Supabase Connect -> Session pooler. URL-encode special password characters.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:5432/postgres?sslmode=require
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# Model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Browser clients allowed to call FastAPI, comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional base directory for separate persistent Chromium profiles.
# Defaults to ~/.trojanclaw/connectors. See ../CONNECTORS.md.
TROJANCLAW_SESSION_DIR=

# Local nspady Google Calendar MCP: Web application OAuth client.
# Enable the standard Google Calendar API; Developer Preview enrollment is unnecessary.
# Register BOTH /calendar/callback and /auth/google/callback on the same backend host.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/calendar/callback
GOOGLE_CALENDAR_FRONTEND_URL=http://localhost:5173
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable and private; it encrypts Google tokens stored in PostgreSQL.
GOOGLE_CALENDAR_ENCRYPTION_KEY=
